RESCUE_MAX_PRIORITY_FEE_GWEI="120"

# Optional Alchemy configuration.
# ALCHEMY_GAS_POLICY_ID is not enough by itself for the local rescue script;
# use POLYGON_RPC_URL for an Alchemy Polygon RPC endpoint if desired.
ALCHEMY_API_KEY=""
ALCHEMY_GAS_POLICY_ID=""

# 4EVERLAND Hosting - keep real values only in local .env
FOUR_EVERLAND_HOSTING_TOKEN=""
FOUR_EVERLAND_PROJECT_ID=""
