# Owner action: update ERC-2981 royalty receiver on the V2 contract.
ROYALTY_CONTRACT_ADDRESS="0x28c9Ad86A58936ee1e34ed08BF21A86c52747920"
ROYALTY_RECEIVER="0x392DC017bf81b7c351042225aa0d22C1f69EAC4E"
